# Feishu China: https://open.feishu.cn / https://accounts.feishu.cn
# Lark Global: https://open.larksuite.com / https://accounts.larksuite.com
LARK_APP_ID=
LARK_APP_SECRET=
LARK_API_BASE=https://open.feishu.cn
LARK_AUTH_BASE=https://accounts.feishu.cn
LARK_REDIRECT_URL=http://127.0.0.1:8765/auth/lark/callback

# 0 means every visible conversation. Set a positive number for a bounded pilot.
LARK_SYNC_CHAT_LIMIT=0
LARK_POLL_INTERVAL=8s

MEMORY_LOOKBACK_DAYS=30
MEMORY_INITIALIZATION_WORKERS=2
MEMORY_DECAY_HALF_LIFE_DAYS=90
PROFILE_DAILY_TIME=03:00
PROFILE_TIMEZONE=Asia/Shanghai

# OpenAI-compatible Agent endpoint. Keep the real key outside Git.
AGENT_API_KEY=
AGENT_BASE_URL=http://127.0.0.1:18766/v1
AGENT_MODEL=grok-4.5
AGENT_MEMORY_REASONING_EFFORT=medium
AGENT_REPLY_REASONING_EFFORT=low
AGENT_MEMORY_TIMEOUT=5m
AGENT_REPLY_TIMEOUT=1m
